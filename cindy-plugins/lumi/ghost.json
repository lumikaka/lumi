{
  "schemaVersion": 3,
  "minCindyVersion": "0.1.121",
  "id": "lumi",
  "name": "Lumi",
  "description": "在 Cindy 当前 Lumi 项目中完成故事、设定、章节和页面创作，导入授权图片并导出作品；无需 Lumi 模型服务商。审阅界面尚未实现。",
  "whenToUse": "初始化或打开 Lumi 项目、创作或修改故事与设定、逐章逐页保存正文与画面描述、审阅文本并导出作品。",
  "version": "0.4.0",
  "entry": "main.js",
  "icon": "assets/icon.png",
  "tools": [
    {
      "name": "list_tools",
      "description": "不传 category 返回类别概览；指定类别返回工具说明、JSON Schema 与必要 RULES。图片使用独立 receive_media 附件入口；review 尚未实现。",
      "parameters": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "call_tool",
      "description": "执行 list_tools 返回的允许工具；args 必须是该工具的 JSON 对象参数。失败返回 schema 与自纠规则，不代理任意 MCP/CLI/HTTP/SQL。",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "args": {
            "type": "object"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "receive_media",
      "description": "接收 ghost_call.attachments 中恰好一张授权图片，校验原件并保存到当前任务项目。先 image_target 获取 target_uuid、slot 与 expected_revision。不接受路径、指纹或内联字节。",
      "parameters": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "slot": {
                  "const": "page_image"
                }
              }
            },
            "then": {
              "required": [
                "prompt",
                "preparation"
              ]
            }
          }
        ],
        "properties": {
          "description": {
            "maxLength": 12000,
            "type": "string"
          },
          "expected_revision": {
            "description": "Exact revision from the last read or render_prompt; required for every mutation.",
            "minimum": 0,
            "type": "integer"
          },
          "fit_mode": {
            "enum": [
              "keep",
              "crop",
              "pad"
            ],
            "type": "string"
          },
          "preparation": {
            "additionalProperties": false,
            "properties": {
              "additional_direction": {
                "maxLength": 12000,
                "type": "string"
              },
              "digest": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "expected_revision": {
                "description": "Exact revision from the last read or render_prompt; required for every mutation.",
                "minimum": 0,
                "type": "integer"
              },
              "page_uuid": {
                "description": "Public UUIDv7 from a previous read.",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              },
              "project_uuid": {
                "description": "Public UUIDv7 from a previous read.",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                "type": "string"
              },
              "setting_uuids": {
                "description": "Explicit current-project active settings in collage label order. [] means a real no-reference generation; omitted/null is invalid.",
                "items": {
                  "description": "Public UUIDv7 from a previous read.",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
                  "type": "string"
                },
                "maxItems": 12,
                "type": "array",
                "uniqueItems": true
              },
              "signature": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            },
            "required": [
              "project_uuid",
              "page_uuid",
              "expected_revision",
              "setting_uuids",
              "additional_direction",
              "digest",
              "signature"
            ],
            "type": "object"
          },
          "prompt": {
            "maxLength": 12000,
            "type": "string"
          },
          "slot": {
            "enum": [
              "page_image",
              "setting_image"
            ],
            "type": "string"
          },
          "target_uuid": {
            "description": "Public UUIDv7 from a previous read.",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "type": "string"
          }
        },
        "required": [
          "target_uuid",
          "slot",
          "expected_revision"
        ],
        "type": "object"
      }
    }
  ],
  "node": {
    "entry": "node/worker.cjs",
    "protocol": "json-rpc-stdio",
    "lifecycle": "on-demand",
    "idleTimeoutSeconds": 120,
    "childSpawn": true,
    "entries": [
      "node/request-lifetime.cjs"
    ]
  },
  "command": "lumi",
  "launch": "on-demand",
  "sessionContext": true,
  "releaseNotes": "新增授权附件原件校验与分块导入、受控参考图回送、开发包身份和运行环境隔离；修复旧共享 CLI 的兼容性检测，明确区分安装包与运行后台，保留项目绑定、文本工具和标准项目格式。",
  "manual": {
    "items": [
      {
        "name": "runtime",
        "title": "运行与恢复",
        "description": "诊断、只读限制、释放连接与共享服务边界。",
        "dir": "manual/runtime"
      },
      {
        "name": "project",
        "title": "项目初始化与创作规约",
        "description": "目录选择、原地 draft 与 setup、重复初始化、桌面切换与创作边界。",
        "dir": "manual/project"
      },
      {
        "name": "authoring",
        "title": "文本创作与恢复",
        "description": "项目识别、setup、故事、设定、章节和页面、文本审阅与导出，以及冲突、中断和额度耗尽恢复。",
        "dir": "manual/authoring"
      }
    ]
  },
  "cindy": {
    "media": [
      "deposit"
    ]
  }
}
