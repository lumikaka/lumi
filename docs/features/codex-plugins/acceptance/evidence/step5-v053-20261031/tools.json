          {
            "if": {
              "properties": {
                "action": {
                  "const": "write"
                }
              }
            },
            "then": {
              "required": [
                "chapter_uuid",
                "content",
                "expected_revision"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "action": {
                  "const": "delete"
