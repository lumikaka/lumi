APP_ENV=development
# Optional: debug, info, warn, or error. Defaults to info here and warn in production.
# LOG_LEVEL=debug
APP_ADDRESS=127.0.0.1:5801
FRONTEND_URL=http://localhost:5801
VITE_DEV_SERVER_URL=http://127.0.0.1:5802
# Optional test/development override. Defaults to ~/.lumi_dev (or ~/.lumi in production).
# LUMI_DATA_DIR=/absolute/path/to/lumi-data

# Workflow text generation request timeout (1s..1h); ordinary chat keeps 5m.
# LUMI_WORKFLOW_REQUEST_TIMEOUT=15m
