#!/usr/bin/env bash
set -euo pipefail

SESSION_NAME="${TMUX_SESSION_NAME:-lumi-dev}"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

for required_command in tmux pnpm go; do
  if ! command -v "${required_command}" >/dev/null 2>&1; then
    echo "${required_command} is not installed." >&2
    exit 1
  fi
done

if ! tmux has-session -t "${SESSION_NAME}" 2>/dev/null; then
  tmux new-session -d -s "${SESSION_NAME}" -n dev -c "${ROOT_DIR}"
  tmux send-keys -t "${SESSION_NAME}:dev.0" "pnpm --dir web run dev" C-m

  API_PANE="$(tmux split-window -h -t "${SESSION_NAME}:dev.0" -c "${ROOT_DIR}" -P -F "#{pane_id}")"
  tmux send-keys -t "${API_PANE}" "go tool air" C-m
  tmux select-pane -t "${SESSION_NAME}:dev.0"
fi

if [ -n "${TMUX:-}" ]; then
  tmux switch-client -t "${SESSION_NAME}"
else
  tmux attach-session -t "${SESSION_NAME}"
fi
